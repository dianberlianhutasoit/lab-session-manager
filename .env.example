# Konfigurasi Firebase Firestore (Salin ke file .env / .env.local)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Konfigurasi Google Maps Android SDK (Opsional untuk Expo Go; Wajib untuk Standalone/Development Build Android)
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Maps SDK for Android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
