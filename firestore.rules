rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (Fungsi Keamanan)
    // ==========================================

    // Memeriksa apakah pengguna sudah login via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Memeriksa apakah UID pengguna sesuai dengan dokumen pemilik
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Mengambil data pengguna dari koleksi users
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Memeriksa apakah pengguna memiliki role 'aslab' (Asisten Laboratorium)
    function isAslab() {
      return isAuthenticated() && (
        request.auth.token.role == 'aslab' ||
        getUserData().role == 'aslab'
      );
    }

    // Memeriksa apakah pengguna memiliki role 'asprak' atau legacy 'asisten'
    function isAsprak() {
      return isAuthenticated() && (
        request.auth.token.role == 'asprak' ||
        request.auth.token.role == 'asisten' ||
        getUserData().role == 'asprak' ||
        getUserData().role == 'asisten'
      );
    }

    // Memeriksa apakah pengguna memiliki hak pengelola (Asprak, Aslab, atau legacy Asisten)
    function isAssistant() {
      return isAsprak() || isAslab();
    }

    // Memeriksa apakah pengguna memiliki role 'praktikan'
    function isPractitioner() {
      return isAuthenticated() && (
        request.auth.token.role == 'praktikan' ||
        getUserData().role == 'praktikan'
      );
    }

    // ==========================================
    // 1. KOLEKSI USERS (SRS-02)
    // ==========================================
    match /users/{userId} {
      // Semua pengguna login bisa membaca profil dasar sesama pengguna/asisten
      allow read: if isAuthenticated();
      // Pengguna hanya bisa mendaftarkan profil miliknya sendiri saat awal registrasi
      allow create: if isAuthenticated() && isOwner(userId);
      // Pemilik profil dapat memperbarui profil miliknya, TETAPI field 'role' bersifat immutable
      // (mencegah privilege escalation dari praktikan menjadi asisten)
      allow update: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.role == resource.data.role;
      allow delete: if false; // Profil tidak boleh sembarangan dihapus
    }

    // ==========================================
    // 2. KOLEKSI CLASSES & SCHEDULES (SRS-07)
    // ==========================================
    match /classes/{classId} {
      // Praktikan dan asisten dapat melihat daftar kelas
      allow read: if isAuthenticated();
      // Hanya role Asisten yang berhak membuat, mengedit, atau menghapus kelas
      allow write: if isAssistant();
    }

    match /schedules/{scheduleId} {
      // Praktikan dan asisten dapat melihat jadwal praktikum
      allow read: if isAuthenticated();
      // Hanya role Asisten yang berhak membuat, mengedit, atau menghapus jadwal
      allow write: if isAssistant();
    }

    // ==========================================
    // 3. KOLEKSI SESSIONS & STATUS LOGS (SRS-07 & SRS-08)
    // ==========================================
    match /sessions/{sessionId} {
      // Praktikan dan asisten dapat melihat jadwal & status sesi
      allow read: if isAuthenticated();
      // Hanya role Asisten yang berhak membuka/menutup sesi (OPEN/CLOSED) atau mengubah jadwal
      allow write: if isAssistant();
    }

    match /status_logs/{logId} {
      // Praktikan dan asisten dapat membaca riwayat status sesi
      allow read: if isAuthenticated();
      // Hanya role Asisten yang berhak mencatat riwayat perubahan status sesi
      allow write: if isAssistant();
    }

    match /session_status_logs/{logId} {
      // Koleksi aktual pada COLLECTIONS.STATUS_LOGS
      allow read: if isAuthenticated();
      allow write: if isAssistant();
    }

    // ==========================================
    // 4. KOLEKSI ATTENDANCE (Presensi Praktikan - SRS-05 & SRS-06)
    // ==========================================
    match /attendance/{attendanceId} {
      // Praktikan bisa melihat riwayat presensi miliknya; Asisten bisa melihat rekap semua presensi
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAssistant()
      );

      // Praktikan hanya bisa mencatat kehadiran atas nama dirinya sendiri
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Hanya Asisten yang diizinkan mengoreksi atau menghapus data kehadiran
      allow update, delete: if isAssistant();
    }

    // ==========================================
    // 5. KOLEKSI LEAVE_REQUESTS & PERMISSIONS (Pengajuan Izin - SRS-10 s/d SRS-14)
    // ==========================================
    match /leave_requests/{requestId} {
      // Praktikan hanya bisa membaca izin miliknya; Asisten bisa membaca seluruh pengajuan izin
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAssistant()
      );

      // Praktikan membuat pengajuan izin:
      // - Wajib milik dirinya sendiri (userId == request.auth.uid)
      // - Status awal WAJIB 'PENDING'
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING';

      // Keputusan Izin (SRS-10):
      // Hanya Asisten yang berhak mengubah status pengajuan izin (APPROVED / REJECTED)
      allow update: if isAssistant();

      // Izin hanya bisa dihapus oleh asisten jika diperlukan
      allow delete: if isAssistant();
    }

    match /permissions/{permissionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAssistant()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update, delete: if isAssistant();
    }

    // ==========================================
    // 6. KOLEKSI LABS (Laboratorium - SRS-07 Sprint 3)
    // ==========================================
    match /labs/{labId} {
      // Praktikan dan asisten dapat membaca informasi lokasi laboratorium
      allow read: if isAuthenticated();
      // Hanya role Asisten yang berhak membuat, mengubah, atau menghapus laboratorium
      allow write: if isAssistant();
    }

    // ==========================================
    // 7. KOLEKSI SPRINT 4 (Courses, LabMembers, Attendances, Fines)
    // ==========================================
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAslab() || isAssistant();
    }

    match /labMembers/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAslab() || isAssistant();
    }

    match /attendances/{attendanceId} {
      // Praktikan melihat presensi miliknya; Asprak & Aslab melihat seluruh presensi sesi
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAsprak() || isAslab()
      );
      // Praktikan check-in untuk dirinya sendiri atau Asprak mencatat status EXCUSED/ABSENT
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAsprak()
      );
      allow update, delete: if isAsprak();
    }

    match /fines/{fineId} {
      // Praktikan melihat tagihan denda miliknya; Asprak & Aslab memantau tagihan denda
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAsprak() || isAslab()
      );
      // Tagihan dibuat oleh Asprak atau saat transaksi check-in terlambat praktikan dengan status awal 'unpaid'
      allow create: if isAuthenticated() && (
        isAsprak() ||
        (request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'unpaid')
      );
      // Asprak hanya dapat mengubah denda berstatus 'unpaid' menjadi 'waived'; pemilik tagihan untuk proses bayar
      allow update: if isAuthenticated() && (
        (isAsprak() &&
          (request.resource.data.status != 'waived' || resource.data.status == 'unpaid')) ||
        (resource.data.studentId == request.auth.uid &&
          request.resource.data.status in ['pending', 'paid'])
      );
      allow delete: if false; // Denda tidak dihapus permanen, gunakan status 'waived'
    }
  }
}

